
{
  "hosting": {
    "site": "helioso-website",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],

  "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],

    "redirects": [
      {
        "source": "/**",
        "destination": "https://helioso.com",
        "type": 301
      }
    ]
  }
}